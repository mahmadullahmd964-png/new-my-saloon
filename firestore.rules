rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{id} { allow read: if signedIn() && request.auth.uid == id; allow write: if false; }

    match /users/{id} {
      allow read: if signedIn() && (request.auth.uid == id || isAdmin());
      allow write: if isAdmin();
    }

    match /services/{id} { allow read: if true; allow write: if isAdmin(); }
    match /staff/{id}    { allow read: if true; allow write: if isAdmin(); }

    // One doc per staff+date+time. Create-only => a taken slot can never be booked twice.
    match /slots/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
    }

    match /appointments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }
  }
}
